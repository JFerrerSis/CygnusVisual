---
const currentPath = Astro.url.pathname;
const isSpanish = currentPath.startsWith("/es") || currentPath === "/";
const currentLang = isSpanish ? "es" : "en";

const texts = {
  es: { title: "Contacto", subtitle: "¿Listo para potenciar tu marca? Escríbenos", name: "Nombre completo", email: "Correo electrónico", message: "Mensaje", sendEmail: "Enviar por Email", sendWhatsapp: "Enviar por WhatsApp" },
  en: { title: "Contact", subtitle: "Ready to boost your brand? Write to us", name: "Full name", email: "Email address", message: "Message", sendEmail: "Send by Email", sendWhatsapp: "Send by WhatsApp" },
}[currentLang];
---

<section id="contact" class="py-16 md:py-24 bg-white overflow-hidden">
  <div class="container mx-auto px-4 md:px-6 max-w-7xl">
    
    <div class="mb-10 md:mb-16 text-center lg:text-left">
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-black text-gray-950 tracking-tighter mb-2 md:mb-4">
        {texts.title}<span class="text-blue-600">.</span>
      </h2>
      <p class="text-blue-600 font-black uppercase tracking-[0.1em] md:tracking-[0.2em] text-[9px] md:text-[10px]">
        {texts.subtitle}
      </p>
    </div>

    <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-start">
      
<form id="contact-form" class="lg:col-span-7 bg-gray-50 p-6 sm:p-8 rounded-[2rem] md:rounded-[2.5rem] border border-gray-100 shadow-[0_10px_30px_rgba(37,99,235,0.08)] space-y-5">
  <div>
    <label class="block text-[10px] sm:text-xs font-black text-gray-400 uppercase mb-2 tracking-widest">{texts.name}</label>
    <input type="text" name="name" required class="w-full bg-white border border-gray-200 rounded-xl md:rounded-2xl py-3.5 px-4 focus:border-blue-500 transition-all outline-none text-sm" placeholder="Nombre" />
  </div>
  
  <div>
    <label class="block text-[10px] sm:text-xs font-black text-gray-400 uppercase mb-2 tracking-widest">{texts.email}</label>
    <input type="email" name="email" required class="w-full bg-white border border-gray-200 rounded-xl md:rounded-2xl py-3.5 px-4 focus:border-blue-500 transition-all outline-none text-sm" placeholder="correo@ejemplo.com" />
  </div>

  <div>
    <label class="block text-[10px] sm:text-xs font-black text-gray-400 uppercase mb-2 tracking-widest">{texts.message}</label>
    <textarea name="message" required rows="3" class="w-full bg-white border border-gray-200 rounded-xl md:rounded-2xl py-3.5 px-4 focus:border-blue-500 transition-all outline-none text-sm" placeholder="¿En qué podemos ayudarte?"></textarea>
  </div>

  <button type="submit" id="submit-form" class="w-full bg-blue-600 text-white rounded-xl md:rounded-2xl py-4 font-black uppercase tracking-widest text-xs md:text-sm shadow-[0_10px_20px_rgba(37,99,235,0.2)] hover:bg-blue-700 transition-all">
    {texts.sendEmail}
  </button>
</form>

      <div class="lg:col-span-5 space-y-6">
        
        <div class="bg-gray-50 p-6 md:p-8 rounded-[2rem] md:rounded-[2.5rem] border border-gray-100 shadow-[0_10px_30px_rgba(37,99,235,0.08)] flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <h3 class="font-black text-gray-950 text-sm md:text-base">WhatsApp</h3>
          <button id="submit-whatsapp" class="w-full sm:w-auto bg-green-600 text-white px-6 py-3 rounded-xl md:rounded-2xl font-black text-[10px] md:text-xs uppercase tracking-widest hover:bg-blue-600 transition-all">
            {texts.sendWhatsapp}
          </button>
        </div>

        <div class="bg-gray-50 p-6 md:p-8 rounded-[2rem] md:rounded-[2.5rem] border border-gray-100 shadow-[0_10px_30px_rgba(37,99,235,0.08)]">
          <h3 class="font-black text-gray-950 mb-2 text-sm md:text-base">Email</h3>
          <a href="mailto:Cygnusmedia2@gmail.com" class="text-blue-600 font-bold hover:text-blue-800 transition-colors underline underline-offset-4 text-xs md:text-sm break-all">Cygnusmedia2@gmail.com</a>
        </div>
      </div>
    </div>
  </div>
</section>
<script>
  import Swal from 'sweetalert2'; // Importamos la librería
  
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const btn = document.getElementById('submit-form') as HTMLButtonElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    btn.disabled = true;
    btn.textContent = 'Enviando...';
    
    const formData = new FormData(form);
    const data = { ...Object.fromEntries(formData.entries()), language: window.location.pathname.startsWith('/en') ? 'en' : 'es' };

    try {
      const res = await fetch('/api/contacto', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });

      if (!res.ok) throw new Error();

      // Alerta de éxito con estilo Cygnus
      Swal.fire({
        title: '¡Mensaje enviado!',
        text: 'Te responderemos lo más pronto posible.',
        icon: 'success',
        confirmButtonColor: '#2563eb', // El azul de tu marca
        background: '#fff',
        color: '#000'
      });
      form.reset();

    } catch {
      // Alerta de error
      Swal.fire({
        title: 'Oops...',
        text: 'Algo salió mal, intenta nuevamente.',
        icon: 'error',
        confirmButtonColor: '#ef4444',
      });
    } finally {
      btn.disabled = false;
      btn.textContent = 'Enviar por Email';
    }
  });
</script>