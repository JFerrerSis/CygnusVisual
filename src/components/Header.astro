---
// Header que aparece al hacer scroll
const currentPath = Astro.url.pathname;
const isSpanish = currentPath.startsWith('/es') || currentPath === '/';
const isEnglish = currentPath.startsWith('/en');

// Detectar idioma actual para los links
const currentLang = isSpanish ? 'es' : 'en';

// Links de navegación con sus anchors
const navLinks = [
  { id: 'home', label: 'Inicio', labelEn: 'Home', href: '#home' },
  { id: 'services', label: 'Servicios', labelEn: 'Services', href: '#services' },
  { id: 'about', label: 'Nosotros', labelEn: 'About', href: '#about' },
  { id: 'team', label: 'Equipo', labelEn: 'Team', href: '#team' },
  { id: 'location', label: 'Ubicación', labelEn: 'Location', href: '#location' },
  { id: 'contact', label: 'Contacto', labelEn: 'Contact', href: '#contact' }
];
---

<header class="header-scroll fixed top-0 left-0 w-full z-50 transition-all duration-500">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center py-3 md:py-4">
      
      <!-- Logo con efecto hover -->
      <a 
        href={currentLang === 'es' ? '/es' : '/en'} 
        class="group relative text-2xl font-bold text-white hover:text-gray-100 transition-colors"
      >
        <span class="relative">
          Cygnus<span class="text-gray-200">Visual</span>
        </span>
        <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-white transition-all duration-300 group-hover:w-full"></span>
      </a>
      
      <!-- Navegación Desktop -->
      <nav class="hidden md:flex items-center space-x-1 lg:space-x-2">
        {navLinks.map((link) => (
          <a 
            href={link.href} 
            class="nav-link relative px-3 lg:px-4 py-2 text-white/90 hover:text-white transition-colors text-sm font-medium rounded-lg hover:bg-white/10"
          >
            {currentLang === 'es' ? link.label : link.labelEn}
            <span class="absolute -bottom-0 left-1/2 w-0 h-0.5 bg-white transition-all duration-300 -translate-x-1/2 group-hover:w-6"></span>
          </a>
        ))}
      </nav>
      
      <!-- Selector de idioma + Botón móvil -->
      <div class="flex items-center gap-3">
        
        <!-- Language Switcher mejorado -->
        <div class="language-switcher flex items-center gap-1 bg-white/10 backdrop-blur-sm rounded-full px-1 py-1 border border-white/20 transition-all duration-300">
          <a 
            href="/es" 
            class={`relative px-3 py-1.5 text-sm font-medium rounded-full transition-all duration-300 ${
              isSpanish 
                ? 'text-azul-rey bg-white shadow-md' 
                : 'text-white/80 hover:text-white hover:bg-white/20'
            }`}
          >
            ES
          </a>
          <a 
            href="/en" 
            class={`relative px-3 py-1.5 text-sm font-medium rounded-full transition-all duration-300 ${
              isEnglish 
                ? 'text-azul-rey bg-white shadow-md' 
                : 'text-white/80 hover:text-white hover:bg-white/20'
            }`}
          >
            EN
          </a>
        </div>
        
        <!-- Botón menú móvil mejorado -->
        <button id="menu-btn" class="md:hidden relative w-10 h-10 rounded-lg hover:bg-white/10 transition-all duration-300 focus:outline-none group">
          <div class="absolute inset-0 flex items-center justify-center">
            <svg class="w-5 h-5 text-white transition-transform duration-300 group-hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
          </div>
        </button>
        
        <!-- Botón CTA desktop -->
        <a 
          href="#contact" 
          class="hidden lg:flex items-center gap-2 px-5 py-2 bg-white text-azul-rey rounded-full text-sm font-semibold hover:bg-gray-100 transition-all duration-300 hover:scale-105 shadow-md"
        >
          <span>{currentLang === 'es' ? 'Cotizar' : 'Quote'}</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
      </div>
      
    </div>
    
    <!-- Menú móvil (oculto por defecto) -->
    <div id="mobile-menu" class="hidden md:hidden overflow-hidden">
      <nav class="flex flex-col space-y-1 pb-4 pt-2">
        {navLinks.map((link, index) => (
          <a 
            href={link.href} 
            class="mobile-nav-link px-4 py-3 text-white/80 hover:text-white hover:bg-white/10 rounded-lg transition-all duration-300 text-base font-medium"
            style={`animation-delay: ${index * 0.05}s`}
          >
            <div class="flex items-center justify-between">
              <span>{currentLang === 'es' ? link.label : link.labelEn}</span>
              <svg class="w-4 h-4 opacity-0 group-hover:opacity-100 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </div>
          </a>
        ))}
        
        <div class="border-t border-white/10 my-2"></div>
        
        <a 
          href="#contact" 
          class="mx-4 mt-2 px-4 py-3 bg-white text-azul-rey rounded-lg text-center font-semibold hover:bg-gray-100 transition-all duration-300"
        >
          {currentLang === 'es' ? 'Cotizar ahora' : 'Get a quote'}
        </a>
      </nav>
    </div>
    
  </div>
  
  <!-- Barra de progreso de scroll -->
  <div class="progress-bar absolute bottom-0 left-0 h-0.5 bg-white/50 w-0 transition-all duration-300"></div>
  
</header>

<style is:global>
  /* Estado inicial - transparente */
  .header-scroll {
    background-color: transparent;
    transform: translateY(0);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  /* Estado con scroll - fondo sólido */
  .header-scroll.scrolled {
    background-color: rgba(0, 51, 160, 0.95);
    backdrop-filter: blur(8px);
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.3);
  }
  
  /* Efecto de hover en los links */
  .nav-link {
    transition: all 0.3s ease;
  }
  
  html {
    scroll-behavior: smooth;
  }
  
  section, [id] {
    scroll-margin-top: 80px;
  }
  
  @keyframes slideIn {
    from {
      opacity: 0;
      transform: translateX(-20px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }
  
  .mobile-nav-link {
    animation: slideIn 0.3s ease-out forwards;
    opacity: 0;
  }
</style>

<script>
  (function() {
    // Elementos del DOM
    const header = document.querySelector('.header-scroll') as HTMLElement | null;
    const progressBar = document.querySelector('.progress-bar') as HTMLElement | null;
    const menuBtn = document.getElementById('menu-btn') as HTMLButtonElement | null;
    const mobileMenu = document.getElementById('mobile-menu') as HTMLElement | null;
    
    let ticking = false;
    let isMenuOpen = false;
    let lastScroll = 0;
    
    // ==================== HEADER SCROLL ====================
    function updateHeader() {
      if (!header) return;
      const currentScroll = window.pageYOffset;
      
      // Agregar/quitar clase scrolled basado en scroll
      if (currentScroll > 10) {
        header.classList.add('scrolled');
      } else {
        header.classList.remove('scrolled');
      }
      
      // Actualizar barra de progreso
      if (progressBar) {
        const scrollPercent = (currentScroll / (document.documentElement.scrollHeight - window.innerHeight)) * 100;
        progressBar.style.width = scrollPercent + '%';
      }
      
      lastScroll = currentScroll;
      ticking = false;
    }
    
    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(updateHeader);
        ticking = true;
      }
    });
    
    // ==================== MENÚ MÓVIL ====================
    function toggleMenu() {
      if (!menuBtn || !mobileMenu) return;
      
      isMenuOpen = !isMenuOpen;
      
      if (isMenuOpen) {
        mobileMenu.classList.remove('hidden');
        menuBtn.innerHTML = `
          <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        `;
        document.body.style.overflow = 'hidden';
      } else {
        mobileMenu.classList.add('hidden');
        menuBtn.innerHTML = `
          <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        `;
        document.body.style.overflow = '';
      }
    }
    
    if (menuBtn) {
      menuBtn.addEventListener('click', toggleMenu);
    }
    
    // Cerrar menú móvil al hacer clic en un link
    const mobileLinks = document.querySelectorAll('#mobile-menu a');
    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        if (isMenuOpen && mobileMenu) {
          mobileMenu.classList.add('hidden');
          if (menuBtn) {
            menuBtn.innerHTML = `
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
              </svg>
            `;
          }
          document.body.style.overflow = '';
          isMenuOpen = false;
        }
      });
    });
    
    // ==================== CIERRE AUTOMÁTICO AL REDIMENSIONAR ====================
    window.addEventListener('resize', () => {
      if (window.innerWidth >= 768 && isMenuOpen && mobileMenu && menuBtn) {
        mobileMenu.classList.add('hidden');
        menuBtn.innerHTML = `
          <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        `;
        document.body.style.overflow = '';
        isMenuOpen = false;
      }
    });
    
    // ==================== DESTACAR LINK ACTIVO ====================
    const sections = document.querySelectorAll('section[id]');
    const navLinks = document.querySelectorAll('.nav-link');
    
    function highlightActiveLink() {
      const scrollPosition = window.scrollY + 100;
      
      sections.forEach((section) => {
        const sectionElement = section as HTMLElement;
        const sectionTop = sectionElement.offsetTop;
        const sectionBottom = sectionTop + sectionElement.offsetHeight;
        const sectionId = sectionElement.getAttribute('id');
        
        if (scrollPosition >= sectionTop && scrollPosition < sectionBottom) {
          navLinks.forEach((link) => {
            const anchor = link as HTMLAnchorElement;
            anchor.classList.remove('text-white', 'font-bold');
            anchor.classList.add('text-white/80');
            
            if (anchor.getAttribute('href') === `#${sectionId}`) {
              anchor.classList.remove('text-white/80');
              anchor.classList.add('text-white', 'font-bold');
            }
          });
        }
      });
    }
    
    window.addEventListener('scroll', highlightActiveLink);
    highlightActiveLink();
    
    // Llamar al inicio para asegurar estado correcto
    updateHeader();
    
  })();
</script>