---
const { t } = Astro.props;
const jsonTeam = t?.team || {};
const teamMembers = Array.isArray(jsonTeam.members) ? jsonTeam.members : [];
---

<section id="team" class="py-24 bg-slate-50 overflow-hidden">
  <div class="container mx-auto px-6 mb-16 text-center lg:text-left">
    <h2 class="text-4xl md:text-5xl font-black text-gray-900 tracking-tighter mb-4">
      {jsonTeam.title}<span class="text-blue-600">.</span>
    </h2>
    <p class="text-blue-600 font-black uppercase tracking-[0.2em] text-[10px]">
      {jsonTeam.subtitle}
    </p>
  </div>

  <div id="carousel-wrapper" class="flex gap-8 cursor-grab active:cursor-grabbing px-6">
    {[...teamMembers, ...teamMembers].map((member) => (
      <div class="card-item min-w-[280px] md:min-w-[320px]">
        <div class="relative bg-white rounded-[2rem] border border-blue-100 p-6 h-full 
                    shadow-[0_15px_35px_-10px_rgba(37,99,235,0.2)]">
          
          <div class="relative w-full h-64 mb-6 overflow-hidden rounded-[1.5rem]">
            <img src={`/assets/team/${member.img}`} alt={member.role} class="w-full h-full object-contain p-2" onerror="this.src='/assets/azul.png'" />
          </div>
          
          <h3 class="text-sm font-black text-blue-600 uppercase tracking-widest mb-4">
            {member.role}
            <span class="block w-16 h-1 bg-gradient-to-r from-blue-600 to-transparent mt-2 rounded-full"></span>
          </h3>
          
          <p class="text-gray-500 text-[11px] leading-relaxed italic border-l-2 border-blue-200 pl-4">
            "{member.bio}"
          </p>
        </div>
      </div>
    ))}
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { Draggable } from 'gsap/Draggable';

  gsap.registerPlugin(Draggable);

  const wrapper = document.querySelector('#carousel-wrapper') as HTMLElement;
  
  if (wrapper) {
    const totalWidth = wrapper.scrollWidth / 2;

    // 1. Animación automática
    const tl = gsap.to(wrapper, {
      x: -totalWidth,
      duration: 40,
      ease: "none",
      repeat: -1,
    });

    // 2. Hacer el carrusel arrastrable (Draggable)
    Draggable.create(wrapper, {
      type: "x",
      bounds: { minX: -totalWidth, maxX: 0 },
      inertia: true, // Agrega un efecto de inercia al soltar
      onDragStart: () => tl.pause(), // Pausamos la animación al tocar
      onDragEnd: () => tl.play(),    // Reanudamos al soltar
    });

    // 3. Pausar al pasar el mouse
    wrapper.addEventListener('mouseenter', () => tl.pause());
    wrapper.addEventListener('mouseleave', () => tl.play());
  }
</script>