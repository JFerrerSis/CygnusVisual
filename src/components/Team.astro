---
const { t } = Astro.props;
const jsonTeam = t?.team || {};
const teamMembers = Array.isArray(jsonTeam.members) ? jsonTeam.members : [];

const getRoleInitials = (role: string) => {
  return role.split(" ").map(word => word[0]).slice(0, 2).join("").toUpperCase();
};
---

<section id="team" class="py-24 bg-gray-50">
  <div class="container mx-auto px-6 max-w-7xl">
    
    <div class="mb-16">
      <h2 class="text-5xl font-black text-gray-900 tracking-tighter mb-4">
        {jsonTeam.title || "EQUIPO"}<span class="text-blue-600">.</span>
      </h2>
      <p class="text-blue-600 font-black uppercase tracking-[0.2em] text-[10px]">
        {jsonTeam.subtitle || "TALENTO HUMANO"}
      </p>
    </div>

    <!-- Grid con efecto LED estático -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6">
      {teamMembers.map((member: any) => (
        <div class="bg-white p-8 rounded-[2.5rem] border-2 border-blue-500/30 
                    shadow-[0_0_20px_rgba(37,99,235,0.1)] 
                    flex flex-col items-center text-center transition-all">
          
          <!-- Icono con brillo constante -->
          <div class="w-20 h-20 mb-8 bg-blue-600 rounded-full flex items-center justify-center text-white font-black text-xl tracking-widest 
                      shadow-[0_0_20px_rgba(37,99,235,0.4)]">
            {getRoleInitials(member.role)}
          </div>

          <h3 class="text-sm font-black text-gray-900 mb-4 uppercase tracking-wider">
            {member.role}
          </h3>
          
          <p class="text-gray-500 text-[11px] leading-relaxed">
            {member.bio}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>