---
const { t } = Astro.props;
const jsonAbout = t?.about || {};

const missionText = jsonAbout.mission || "Misión: Democratizar el acceso a contenido visual de alta calidad.";
const visionText = jsonAbout.vision || "Visión: Ser referentes en innovación visual en Latinoamérica.";

const missionBody = missionText.includes("Misión:") ? missionText.split("Misión:")[1].trim() : missionText;
const visionBody = visionText.includes("Visión:") ? visionText.split("Visión:")[1].trim() : visionText;
---

<section id="about" class="py-28 bg-white relative overflow-hidden">
  <div class="container mx-auto px-6 max-w-7xl relative z-10">
    
    <div class="grid lg:grid-cols-12 gap-16 items-center">
      
      <!-- Lado Izquierdo: Texto -->
      <div class="lg:col-span-5 space-y-8">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-blue-50 rounded-full border border-blue-100">
          <span class="w-2 h-2 bg-blue-600 rounded-full animate-pulse"></span>
          <span class="text-[10px] font-black text-blue-600 uppercase tracking-[0.2em]">{t?.nav?.about || 'Nosotros'}</span>
        </div>
        
        <h2 class="text-5xl md:text-6xl font-black text-gray-900 tracking-tighter leading-[0.95]">
          {jsonAbout.title || 'Sobre Nosotros'}<span class="text-blue-600">.</span>
        </h2>
        
        <p class="text-gray-500 text-lg leading-relaxed font-medium">
          {jsonAbout.description || 'En Cygnus Visual combinamos tecnología de vanguardia con creatividad ilimitada.'}
        </p>

        <a href="#contact" id="about-cta" 
           class="inline-flex items-center gap-3 px-10 py-5 bg-blue-600 text-white rounded-2xl font-black hover:bg-blue-700 transition-all shadow-[0_10px_30px_rgba(37,99,235,0.4)]">
          <span>{t?.services?.cta || 'Conoce nuestro trabajo'}</span>
        </a>
      </div>
      
      <!-- Lado Derecho: Tarjetas LED -->
      <div class="lg:col-span-7 grid sm:grid-cols-2 gap-8">
        
        {[ { title: "Misión", body: missionBody, icon: "M12 2a10 10 0 1010 10 10 10 0 00-10-10zM12 6v6l4 2" },
           { title: "Visión", body: visionBody, icon: "M22 12h-4l-3 9L9 3l-3 9H2" } ].map((item) => (
          <div class="bg-white rounded-[2.5rem] p-8 border-2 border-blue-500/30 shadow-[0_0_30px_rgba(37,99,235,0.25)] transition-all">
            <div class="w-14 h-14 bg-blue-50 rounded-2xl flex items-center justify-center mb-6 border border-blue-100">
              <svg class="w-7 h-7 text-blue-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d={item.icon}/>
              </svg>
            </div>
            <h3 class="text-2xl font-black text-gray-900 mb-3 tracking-tight">{item.title}</h3>
            <p class="text-gray-500 leading-relaxed text-sm">{item.body}</p>
          </div>
        ))}
        
      </div>
    </div>
  </div>
</section>

<script>
  document.getElementById('about-cta')?.addEventListener('click', (e) => {
    e.preventDefault();
    document.getElementById('contact')?.scrollIntoView({ behavior: 'smooth' });
  });
</script>