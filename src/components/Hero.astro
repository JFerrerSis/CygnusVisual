---
const t = Astro.props.t;
const currentPath = Astro.url.pathname;
const isSpanish = currentPath.startsWith('/es') || currentPath === '/';
const currentLang = isSpanish ? 'es' : 'en';

// 1. Traer la variable de entorno de WhatsApp y limpiarla
const rawWhatsAppNumber = import.meta.env.WHATSAPP_NUMBER || '';
const whatsAppNumber = rawWhatsAppNumber.replace(/[^0-9]/g, '');

// 2. Definir el mensaje predeterminado según el idioma de la página
const defaultTextEs = "Hola Cygnus Visual, vi su sitio web y me gustaría obtener más información sobre sus servicios de marketing audiovisual.";
const defaultTextEn = "Hello Cygnus Visual, I saw your website and I would like to get more information about your audiovisual marketing services.";
const chosenText = isSpanish ? defaultTextEs : defaultTextEn;

// 3. Codificar el texto para que sea seguro en una URL (cambia espacios por %20, etc.)
const encodedMessage = encodeURIComponent(chosenText);

// 4. Armar la URL final con el número y el mensaje
const whatsappUrl = whatsAppNumber 
  ? `https://wa.me/${whatsAppNumber}?text=${encodedMessage}`
  : `https://wa.me/message/RSSN7IQ2AV6N1`; // Mantiene el link original como fallback por si no hay .env

// Convertir servicios a array si es string
const servicesArray = typeof t.hero?.services === 'string' 
  ? t.hero.services.split(' | ') 
  : (t.hero?.servicesList || []);
---

<section id="home" class="relative min-h-screen flex items-center justify-center overflow-hidden bg-black pt-16 sm:pt-0">
  
  <div class="absolute inset-0">
    <div class="absolute inset-0 bg-gradient-to-br from-black via-azul-rey/10 to-black"></div>
    <div class="absolute inset-0 overflow-hidden">
      <div class="absolute -top-40 -right-40 w-80 h-80 bg-azul-rey/20 rounded-full blur-3xl animate-pulse-slow"></div>
      <div class="absolute -bottom-40 -left-40 w-80 h-80 bg-azul-rey/10 rounded-full blur-3xl animate-pulse-slower"></div>
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-azul-rey/5 rounded-full blur-3xl animate-spin-slow"></div>
    </div>
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,_rgba(0,51,160,0.1)_1px,_transparent_1px)] bg-[size:40px_40px]"></div>
    <div class="absolute inset-0 overflow-hidden">
      <div class="absolute top-1/3 left-0 w-full h-px bg-gradient-to-r from-transparent via-azul-rey/30 to-transparent animate-slide-right"></div>
      <div class="absolute bottom-1/3 left-0 w-full h-px bg-gradient-to-r from-transparent via-azul-rey/20 to-transparent animate-slide-left"></div>
    </div>
  </div>
  
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10 py-8 sm:py-12">
    <div class="flex flex-col lg:grid lg:grid-cols-2 gap-8 lg:gap-12 items-center">
      
      <div class="text-center lg:text-left order-2 lg:order-1 space-y-4 sm:space-y-6">
        
       <div class="flex flex-col items-center lg:items-start text-center lg:text-left">
          <img 
            id="logoico"
            src="/assets/logoico.webp" 
            alt="Cygnus Visual Logo" 
            class="h-24 sm:h-32 md:h-40 w-auto object-contain mb-4 lg:ml-32 animate-spin-slow"
          />
          
          <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-black leading-tight">
            <span class="text-white">CYGNUS</span>
            <span class="text-azul-rey"> VISUAL</span>
          </h1>
          
          <div class="w-16 sm:w-20 h-0.5 sm:h-1 bg-azul-rey mt-4 mb-6"></div>
        </div>
        
        <div class="space-y-3 sm:space-y-4">
          <p class="text-azul-rey text-sm sm:text-base md:text-lg lg:text-xl font-semibold tracking-wide animate-fade-up animation-delay-200 px-2 sm:px-0">
            {t.hero?.slogan || "Audiovisual Marketing on Social Media • LATAM™"}
          </p>
          
          {servicesArray.length > 0 && (
            <div class="flex flex-wrap gap-1.5 sm:gap-2 justify-center lg:justify-start">
              {servicesArray.map((service: string, idx: number) => (
                <span 
                  class="inline-flex items-center gap-1 px-2 sm:px-3 py-1 sm:py-1.5 bg-white/5 backdrop-blur-sm rounded-full text-[10px] sm:text-xs text-gray-300 border border-white/10 animate-fade-up" 
                  style={`animation-delay: ${idx * 0.05}s`}
                >
                  <span class="w-1 h-1 bg-azul-rey rounded-full"></span>
                  {service.trim()}
                </span>
              ))}
            </div>
          )}
        </div>
        
        <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 pt-2 sm:pt-4 justify-center lg:justify-start">
          <a id="hero-cont"
            href="#contact" 
            class="group relative inline-flex items-center justify-center gap-2 px-5 sm:px-6 md:px-8 py-2.5 sm:py-3 md:py-4 bg-gradient-to-r from-azul-rey to-azul-rey-dark rounded-full font-bold text-white text-sm sm:text-base overflow-hidden transition-all duration-500 hover:scale-105 hover:shadow-2xl hover:shadow-azul-rey/40 animate-fade-up animation-delay-300"
          >
            <span class="relative z-10">{t.hero?.cta || "Contact us"}</span>
            <svg class="relative z-10 w-4 sm:w-5 h-4 sm:h-5 group-hover:translate-x-1 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
            <div class="absolute inset-0 bg-gradient-to-r from-azul-rey-dark to-azul-rey opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          </a>
          
          <a 
            href={whatsappUrl} 
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center justify-center gap-2 px-5 sm:px-6 md:px-8 py-2.5 sm:py-3 md:py-4 bg-white/5 backdrop-blur-md border border-white/20 rounded-full font-semibold text-white text-sm sm:text-base hover:bg-white/10 hover:border-azul-rey/50 transition-all duration-300 hover:scale-105 animate-fade-up animation-delay-400 relative"
          >
            <svg class="w-4 sm:w-5 h-4 sm:h-5 text-green-400 group-hover:scale-110 transition-transform duration-300" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-5.45-4.45-9.9-9.91-9.9z"/>
            </svg>
            <span>{t.hero?.whatsapp || "WhatsApp"}</span>
            <span class="absolute -top-1 -right-1 w-1.5 sm:w-2 h-1.5 sm:h-2 bg-green-500 rounded-full animate-pulse"></span>
          </a>
        </div>
        
        <div class="grid grid-cols-3 gap-2 sm:gap-4 md:gap-6 max-w-md pt-4 sm:pt-6 border-t border-white/10 animate-fade-up animation-delay-500 mx-auto lg:mx-0">
          <div class="group text-center lg:text-left cursor-pointer">
            <div class="text-xl sm:text-2xl md:text-3xl lg:text-4xl font-black text-azul-rey mb-0.5 sm:mb-1 group-hover:text-white transition-colors duration-300">
              {t.hero?.stats?.followers || "+200%"}
            </div>
            <div class="text-[9px] sm:text-xs text-gray-400 uppercase tracking-wider">{t.hero?.stats?.followersLabel || "Growth"}</div>
            <div class="w-0 h-0.5 bg-azul-rey group-hover:w-full transition-all duration-500 mt-1 sm:mt-2 mx-auto lg:mx-0"></div>
          </div>
          <div class="group text-center lg:text-left cursor-pointer">
            <div class="text-xl sm:text-2xl md:text-3xl lg:text-4xl font-black text-azul-rey mb-0.5 sm:mb-1 group-hover:text-white transition-colors duration-300">
              {t.hero?.stats?.projects || "100%"}
            </div>
            <div class="text-[9px] sm:text-xs text-gray-400 uppercase tracking-wider">{t.hero?.stats?.projectsLabel || "Satisfaction"}</div>
            <div class="w-0 h-0.5 bg-azul-rey group-hover:w-full transition-all duration-500 mt-1 sm:mt-2 mx-auto lg:mx-0"></div>
          </div>
          <div class="group text-center lg:text-left cursor-pointer">
            <div class="text-xl sm:text-2xl md:text-3xl lg:text-4xl font-black text-azul-rey mb-0.5 sm:mb-1 group-hover:text-white transition-colors duration-300">
              {t.hero?.stats?.following || "24/7"}
            </div>
            <div class="text-[9px] sm:text-xs text-gray-400 uppercase tracking-wider">{t.hero?.stats?.followingLabel || "Support"}</div>
            <div class="w-0 h-0.5 bg-azul-rey group-hover:w-full transition-all duration-500 mt-1 sm:mt-2 mx-auto lg:mx-0"></div>
          </div>
        </div>
        
      </div>
      
      <div class="relative flex justify-center lg:justify-end order-1 lg:order-2 animate-fade-left animation-delay-200 mb-6 lg:mb-0">
        
        <div class="relative group w-full max-w-sm sm:max-w-md md:max-w-lg lg:max-w-xl">
          
          <div class="absolute -inset-4 sm:-inset-6 md:-inset-8 bg-gradient-to-r from-azul-rey/30 to-azul-rey/10 rounded-full blur-3xl opacity-0 group-hover:opacity-100 transition-opacity duration-700 animate-pulse"></div>
          <div class="absolute -inset-2 sm:-inset-3 rounded-2xl bg-gradient-to-r from-azul-rey via-azul-rey/50 to-transparent opacity-30 group-hover:opacity-60 transition-all duration-500 animate-gradient-x"></div>
          
          <div class="relative bg-gradient-to-br from-white/5 to-white/0 backdrop-blur-sm rounded-2xl p-2 sm:p-3 shadow-2xl">
            
            <div class="relative overflow-hidden rounded-xl">
              <img 
                src="/assets/team/hero.png" 
                alt="Fundadoras de Cygnus Visual"
                class="w-full h-auto object-contain transform group-hover:scale-105 transition-all duration-700 ease-out"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
              <div class="absolute inset-0 translate-y-full group-hover:translate-y-0 transition-transform duration-1000 bg-gradient-to-t from-azul-rey/20 to-transparent"></div>
            </div>
            
            <div class="absolute bottom-0 left-0 right-0 h-0.5 bg-gradient-to-r from-azul-rey via-white/50 to-transparent rounded-b-xl transform scale-x-0 group-hover:scale-x-100 transition-transform duration-700 origin-left"></div>
          </div>
          
          <div class="absolute -top-3 -right-2 sm:-top-4 sm:-right-3 md:-top-6 md:-right-6 bg-black/90 backdrop-blur-md border-2 border-azul-rey rounded-lg sm:rounded-xl px-2 sm:px-3 md:px-5 py-1 sm:py-1.5 md:py-2.5 shadow-2xl animate-float z-20">
            <div class="flex items-center gap-1 sm:gap-2">
              <span class="text-azul-rey font-black text-base sm:text-lg md:text-xl">🚀</span>
              <span class="text-white font-bold text-[8px] sm:text-[10px] md:text-xs lg:text-sm whitespace-nowrap">Expertos en Marketing Digital</span>
            </div>
          </div>
          
          <div class="absolute top-1/4 -left-4 md:-left-6 lg:-left-8 bg-gradient-to-r from-azul-rey to-azul-rey-dark rounded-lg px-2 md:px-3 lg:px-5 py-1 md:py-1.5 lg:py-2.5 shadow-2xl animate-float-delayed rotate-[-3deg] z-20 hidden lg:flex items-center gap-1 md:gap-2">
            <svg class="w-3 md:w-3.5 lg:w-4 h-3 md:h-3.5 lg:h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"></path>
            </svg>
            <span class="text-white font-bold text-[10px] md:text-xs lg:text-sm whitespace-nowrap">{t.hero?.badgeAgency || "AGENCIA AUDIOVISUAL"}</span>
          </div>
          
          <div class="absolute -bottom-3 -right-2 sm:-bottom-4 sm:-right-3 md:-bottom-6 md:-right-6 bg-white rounded-lg sm:rounded-xl px-2 sm:px-3 md:px-5 py-1 sm:py-1.5 md:py-2.5 shadow-2xl animate-float z-20 flex items-center gap-1 sm:gap-2">
            <span class="text-lg sm:text-xl md:text-2xl">🎬</span>
            <span class="text-black font-bold text-[8px] sm:text-[10px] md:text-xs lg:text-sm whitespace-nowrap">{t.hero?.badgeServices || "SERVICIOS"}</span>
          </div>
          
        </div>
      </div>
      
    </div>
  </div>
  
  <div class="absolute bottom-4 sm:bottom-6 md:bottom-8 left-1/2 -translate-x-1/2 z-10 animate-fade-up animation-delay-800">
    <div class="flex flex-col items-center gap-1 sm:gap-2">
      <span class="text-[8px] sm:text-[10px] text-gray-500 uppercase tracking-widest font-mono">{t.hero?.scroll || "SCROLL"}</span>
      <div class="relative">
        <div class="w-4 sm:w-5 md:w-6 h-6 sm:h-8 md:h-10 border border-white/20 rounded-full flex justify-center">
          <div class="w-0.5 sm:w-1 h-1 sm:h-1.5 md:h-2 bg-white/40 rounded-full mt-1 sm:mt-2 animate-scroll"></div>
        </div>
        <div class="absolute -inset-1 rounded-full border border-azul-rey/30 animate-ping opacity-0"></div>
      </div>
    </div>
  </div>
  
</section>

<style is:global>
  /* Tus keyframes originales intactos */
  @keyframes shine { 0% { background-position: 100% 0%; } 100% { background-position: 0% 100%; } }
  @keyframes gradient { 0%, 100% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } }
  @keyframes gradient-x { 0%, 100% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } }
  @keyframes float { 0%, 100% { transform: translateY(0px) rotate(0deg); } 50% { transform: translateY(-8px) rotate(0deg); } }
  @keyframes scroll { 0% { transform: translateY(0); opacity: 1; } 100% { transform: translateY(8px); opacity: 0; } }
  @keyframes fade-up { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes fade-right { from { opacity: 0; transform: translateX(-20px); } to { opacity: 1; transform: translateX(0); } }
  @keyframes fade-left { from { opacity: 0; transform: translateX(20px); } to { opacity: 1; transform: translateX(0); } }
  @keyframes pulse-slow { 0%, 100% { opacity: 0.3; transform: scale(1); } 50% { opacity: 0.6; transform: scale(1.05); } }
  @keyframes pulse-slower { 0%, 100% { opacity: 0.15; transform: scale(1); } 50% { opacity: 0.3; transform: scale(1.1); } }
  @keyframes spin-slow { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
  @keyframes slide-right { from { transform: translateX(-100%); } to { transform: translateX(100%); } }
  @keyframes slide-left { from { transform: translateX(100%); } to { transform: translateX(-100%); } }

  .animate-spin-slow { animation: spin-slow 20s linear infinite; }
  .animate-float { animation: float 3s ease-in-out infinite; }
  .animate-float-delayed { animation: float 3.5s ease-in-out infinite 0.5s; }
  .animate-scroll { animation: scroll 1.5s ease-in-out infinite; }
  .animate-fade-up { opacity: 0; animation: fade-up 0.5s ease-out forwards; }
  .animate-fade-left { opacity: 0; animation: fade-left 0.5s ease-out forwards; }
  .animate-pulse-slow { animation: pulse-slow 6s ease-in-out infinite; }
  .animate-pulse-slower { animation: pulse-slower 8s ease-in-out infinite; }
  .animate-slide-right { animation: slide-right 4s ease-in-out infinite; }
  .animate-slide-left { animation: slide-left 4s ease-in-out infinite; }
  .animate-gradient-x { background-size: 200% 200%; animation: gradient-x 4s ease infinite; }
  
  .animation-delay-200 { animation-delay: 0.2s; }
  .animation-delay-300 { animation-delay: 0.3s; }
  .animation-delay-400 { animation-delay: 0.4s; }
  .animation-delay-500 { animation-delay: 0.5s; }
  .animation-delay-800 { animation-delay: 0.8s; }
</style>

<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>

<script>
  // Hover effect para el logo
  const logo = document.getElementById('logoico');
  logo?.addEventListener('mouseenter', () => {
    gsap.to(logo, { scale: 1.15, duration: 0.4, ease: "power2.out" });
  });
  logo?.addEventListener('mouseleave', () => {
    gsap.to(logo, { scale: 1, duration: 0.4, ease: "power2.out" });
  });

  document.getElementById('hero-cont')?.addEventListener('click', (e) => {
    e.preventDefault();
    document.getElementById('contact')?.scrollIntoView({ behavior: 'smooth' });
  });
</script>