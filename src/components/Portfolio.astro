---
// 1. Definimos la estructura del tipo para que TypeScript no se pierda
interface Translation {
  title: string;
  subtitle: string;
  btn: string;
}

const lang = (Astro.currentLocale === 'en' ? 'en' : 'es') as 'es' | 'en';

// 2. Aplicamos el tipo al objeto
const i18n: Record<'es' | 'en', Translation> = {
  es: {
    title: "Portafolio",
    subtitle: "Nuestra selección de trabajos visuales.",
    btn: "Ver Proyecto"
  },
  en: {
    title: "Portfolio",
    subtitle: "Our selection of visual works.",
    btn: "View Project"
  }
};

const t = i18n[lang];

const portfolioImages = [
  { src: "/assets/portfolio/5.png", title: "Proyecto A", category: "Social" },
  { src: "/assets/portfolio/6.png", title: "Proyecto B", category: "Branding" },
  { src: "/assets/portfolio/7.png", title: "Proyecto A", category: "Social" },
  { src: "/assets/portfolio/8.png", title: "Proyecto B", category: "Branding" },
];
---

<section id="portfolio" class="py-24 bg-gray-100">
  <div class="container mx-auto px-6 max-w-6xl">
    
    <div class="mb-20 text-center lg:text-left">
      <h2 class="text-6xl md:text-7xl font-black mb-6 tracking-tighter text-gray-900">
        {t.title}<span class="text-blue-600">.</span>
      </h2>
      <p class="text-gray-500 font-medium text-lg">{t.subtitle}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
      {portfolioImages.map((item) => (
        <div class="portfolio-item group relative overflow-hidden rounded-[2.5rem] cursor-pointer" data-src={item.src}>
          <img 
            src={item.src} 
            alt={item.title} 
            class="w-full h-auto block transition-transform duration-700 group-hover:scale-105" 
          />
          <div class="absolute inset-0 bg-blue-900/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
            <span class="text-white font-black tracking-widest uppercase bg-blue-600 px-8 py-3 rounded-full shadow-lg transform scale-90 group-hover:scale-100 transition-transform">
              {t.btn}
            </span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<div id="lightbox" class="fixed inset-0 z-50 hidden bg-black/90 items-center justify-center p-4 backdrop-blur-sm transition-opacity">
  <button id="close-modal" class="absolute top-8 right-8 text-white text-4xl hover:text-blue-500 transition-colors">&times;</button>
  <img id="lightbox-img" src="" class="max-h-[90vh] max-w-[90vw] object-contain rounded-lg shadow-2xl" />
</div>

<script>
  // Script para manejar el modal...
  const lightbox = document.getElementById('lightbox');
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const closeBtn = document.getElementById('close-modal');

  document.querySelectorAll('.portfolio-item').forEach(item => {
    item.addEventListener('click', () => {
      const src = item.getAttribute('data-src');
      if (src) {
        lightboxImg.src = src;
        lightbox?.classList.remove('hidden');
        lightbox?.classList.add('flex');
      }
    });
  });

  closeBtn?.addEventListener('click', () => {
    lightbox?.classList.add('hidden');
    lightbox?.classList.remove('flex');
  });

  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) {
      lightbox.classList.add('hidden');
      lightbox.classList.remove('flex');
    }
  });
</script>