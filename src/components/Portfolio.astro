---
interface Translation {
  title: string;
  subtitle: string;
  btn: string;
  whyUs: string;
  benefits: string[];
  cta: string;
}

const lang = (Astro.currentLocale === 'en' ? 'en' : 'es') as 'es' | 'en';

const i18n: Record<'es' | 'en', Translation> = {
  es: {
    title: "Portafolio",
    subtitle: "Nuestra selección de trabajos visuales.",
    btn: "Ver Proyecto",
    whyUs: "¿Por qué elegirnos?",
    benefits: ['Estrategia basada en datos', 'Producción de alta fidelidad', 'Gestión 360° de tus redes'],
    cta: "Empieza ahora"
  },
  en: {
    title: "Portfolio",
    subtitle: "Our selection of visual works.",
    btn: "View Project",
    whyUs: "Why choose us?",
    benefits: ['Data-driven strategy', 'High-fidelity production', '360° Social Media Management'],
    cta: "Get started"
  }
};
const titles = {
  es: { video: "Presentación", works: "Nuestros Trabajos" },
  en: { video: "Presentation", works: "Our Work" }
};

const sectionTitles = titles[lang];
const t = i18n[lang];

const portfolioImages = [
  { src: "/assets/portfolio/5.png", title: "Proyecto A", category: "Social" },
  { src: "/assets/portfolio/7.png", title: "Proyecto A", category: "Social" },
  { src: "/assets/portfolio/8.png", title: "Proyecto B", category: "Branding" },
];
---

<section id="portfolio" class="py-24 bg-gray-100">
  <div class="container mx-auto px-6 max-w-6xl">
    
    <div class="mb-20 text-center lg:text-left">
      <h2 class="text-6xl md:text-7xl font-black mb-6 tracking-tighter text-gray-900">
        {t.title}<span class="text-blue-600">.</span>
      </h2>
      <p class="text-gray-500 font-medium text-lg">{t.subtitle}</p>
    </div>
<div class="mb-32 flex flex-col items-center px-4">
  
  <h3 class="text-2xl font-black text-gray-900 mb-16 tracking-tight uppercase border-l-4 border-blue-600 pl-4 w-full max-w-4xl">
    {sectionTitles.video}
  </h3>
  
  <div class="w-full max-w-4xl bg-white/50 backdrop-blur-xl border border-white/50 p-6 md:p-12 rounded-[3rem] shadow-[0_20px_50px_rgba(0,0,0,0.05)]">
    
    <div class="flex flex-col lg:flex-row gap-12 items-center lg:items-start justify-center">
      
      <div class="w-full max-w-sm shrink-0">
        <div class="rounded-3xl shadow-[0_0_40px_rgba(37,99,235,0.3)] bg-black overflow-hidden border-2 border-blue-500 p-1">
          <video controls playsinline preload="metadata" class="w-full h-auto block rounded-2xl">
            <source src="/assets/portfolio/presentacion.mp4" type="video/mp4">
          </video>
        </div>
      </div>

      <div class="flex-1 w-full flex flex-col items-center">
        
        <div class="mb-8 ">
          <img 
            src="/assets/azul.png" 
            alt="Cygnus Visual Logo" 
            class="w-20 h-20 object-contain" 
          />
        </div>

        <div class="grid grid-cols-1 gap-4 w-full max-w-md ">
          {t.benefits.map((item, index) => (
            <div class="flex items-center gap-4 bg-white p-5 rounded-2xl shadow-sm border-2 border-blue-500 transition-colors group">
              <div class="w-10 h-10 bg-blue-50 rounded-xl flex items-center justify-center text-blue-600 group-hover:bg-blue-600 group-hover:text-white transition-colors shrink-0 font-black">
                0{index + 1}
              </div>
              <span class="font-bold text-gray-700 text-lg">{item}</span>
            </div>
          ))}
        </div>
        
        <div class="mt-8">
          <a href="#contact" class="inline-flex items-center gap-2 bg-blue-600 text-white px-10 py-4 rounded-full font-black hover:bg-blue-700 transition-all shadow-lg shadow-blue-600/30 transform hover:-translate-y-1">
            {t.cta}
            <span class="text-xl">→</span>
          </a>
        </div>
      </div>
      
    </div>
  </div>
</div>
    <div>
      <h3 class="text-2xl font-black text-gray-900 mb-8 tracking-tight uppercase border-l-4 border-blue-600 pl-4">
        {sectionTitles.works}
      </h3>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
        {portfolioImages.map((item) => (
          <div class="portfolio-item group relative overflow-hidden rounded-[2.5rem] cursor-pointer" data-src={item.src}>
            <img src={item.src} alt={item.title} class="w-full h-auto block transition-transform duration-700 group-hover:scale-105" />
            <div class="absolute inset-0 bg-blue-900/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
              <span class="text-white font-black tracking-widest uppercase bg-blue-600 px-8 py-3 rounded-full shadow-lg transform scale-90 group-hover:scale-100 transition-transform">
                {t.btn}
              </span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  // Script para manejar el modal...
  const lightbox = document.getElementById('lightbox');
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const closeBtn = document.getElementById('close-modal');

  document.querySelectorAll('.portfolio-item').forEach(item => {
    item.addEventListener('click', () => {
      const src = item.getAttribute('data-src');
      if (src) {
        lightboxImg.src = src;
        lightbox?.classList.remove('hidden');
        lightbox?.classList.add('flex');
      }
    });
  });

  closeBtn?.addEventListener('click', () => {
    lightbox?.classList.add('hidden');
    lightbox?.classList.remove('flex');
  });

  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) {
      lightbox.classList.add('hidden');
      lightbox.classList.remove('flex');
    }
  });
</script>