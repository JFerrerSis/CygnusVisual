---
const { t } = Astro.props;
const jsonPortfolio = t?.portfolio || {};

const videosList = Array.isArray(jsonPortfolio.videos)
  ? jsonPortfolio.videos
  : (jsonPortfolio.videos ? Object.values(jsonPortfolio.videos) : []);

const videos = videosList.length > 0 ? videosList : [
  { title: "Campaña Verano 2024", category: "Social", duration: "0:30", thumbnail: "https://images.unsplash.com/photo-1611162617474-5b21e879e113?q=80&w=800", videoUrl: "https://www.youtube.com/embed/dQw4w9WgXcQ", description: "Campaña de verano para marca de moda." },
  { title: "Spot Publicitario", category: "Publicidad", duration: "1:15", thumbnail: "https://images.unsplash.com/photo-1536240478700-b869070f9279?q=80&w=800", videoUrl: "https://www.youtube.com/embed/dQw4w9WgXcQ", description: "Producción completa para TV." },
  { title: "Tips de Marketing", category: "Branding", duration: "2:45", thumbnail: "https://images.unsplash.com/photo-1611162616305-c69b369528b9?q=80&w=800", videoUrl: "https://www.youtube.com/embed/dQw4w9WgXcQ", description: "Contenido viral educativo." }
];

const filterItems = Array.isArray(jsonPortfolio.filters) ? jsonPortfolio.filters : ["Todos", "Social", "Publicidad", "Branding"];
---
<section id="portfolio" class="py-16 md:py-24 bg-gray-50 text-gray-900">
  <div class="container mx-auto px-4 md:px-6 max-w-7xl">
    
    <div class="mb-10 md:mb-16 text-center lg:text-left">
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-black mb-4 tracking-tighter">
        {jsonPortfolio.title || "PORTFOLIO"}<span class="text-blue-600">.</span>
      </h2>
      <p class="text-gray-500 text-base md:text-lg max-w-lg mx-auto lg:mx-0 font-medium">
        {jsonPortfolio.subtitle || "Selección de trabajos destacados realizados con estrategia y diseño."}
      </p>
    </div>
    
    <div class="flex overflow-x-auto gap-3 mb-12 pb-4 scrollbar-hide">
      {filterItems.map((filter: any) => (
        <button class="whitespace-nowrap px-6 py-2.5 rounded-xl text-[10px] md:text-xs font-black uppercase tracking-widest bg-white border-2 border-blue-500/30 text-blue-600 shadow-sm hover:shadow-md transition-all">
          {filter}
        </button>
      ))}
    </div>
    
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
      {videos.map((video: any) => (
        <div class="video-card cursor-pointer group bg-white rounded-[2rem] md:rounded-[2.5rem] p-3 border-2 border-blue-500/10 hover:border-blue-500/30 shadow-lg shadow-blue-900/5 hover:shadow-xl hover:shadow-blue-900/10 transition-all duration-300 flex flex-col h-full" 
             data-video-url={video.videoUrl}>
          
          <div class="relative aspect-[4/3] rounded-[1.5rem] overflow-hidden mb-4">
            <img src={video.thumbnail} alt={video.title} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
            <div class="absolute top-3 left-3 bg-white/90 backdrop-blur text-[9px] md:text-[10px] font-black px-3 py-1 rounded-full uppercase">
              {video.category}
            </div>
            <div class="absolute bottom-3 right-3 bg-blue-600 text-white text-[9px] md:text-[10px] font-black px-3 py-1 rounded-full uppercase shadow-lg">
              {video.duration}
            </div>
          </div>
          
          <div class="px-2 pb-2 flex-grow">
            <h3 class="font-black text-lg md:text-xl mb-1.5">{video.title}</h3>
            <p class="text-gray-500 text-xs md:text-sm leading-relaxed mb-4">{video.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* Oculta la barra de scroll de los filtros pero permite deslizar */
  .scrollbar-hide::-webkit-scrollbar { display: none; }
  .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
</style>
<script>
  // Script para manejar el modal
  const modal = document.getElementById('video-modal');
  const iframe = document.getElementById('video-iframe') as HTMLIFrameElement;
  document.querySelectorAll('.video-card').forEach(card => card.addEventListener('click', () => {
    iframe.src = `${(card as HTMLElement).dataset.videoUrl}?autoplay=1`;
    modal?.classList.remove('hidden'); modal?.classList.add('flex');
  }));
  document.getElementById('close-modal')?.addEventListener('click', () => {
    iframe.src = ''; modal?.classList.add('hidden'); modal?.classList.remove('flex');
  });
</script>