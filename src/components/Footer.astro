<script>
  (function() {
    // Back to top button
    const backToTopBtn = document.getElementById('back-to-top');
    if (backToTopBtn) {
      backToTopBtn.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }
    
    // ==================== MODAL FUNCTIONS ====================
    const privacyModal = document.getElementById('modal-privacy');
    const termsModal = document.getElementById('modal-terms');
    const openPrivacyBtn = document.getElementById('open-privacy');
    const openTermsBtn = document.getElementById('open-terms');
    const closeButtons = document.querySelectorAll('.close-modal');
    
    function openModal(modal: HTMLElement | null) {
      if (modal) {
        modal.style.display = 'flex';
        document.body.style.overflow = 'hidden';
      }
    }
    
    function closeModal(modal: HTMLElement | null) {
      if (modal) {
        modal.style.display = 'none';
        document.body.style.overflow = '';
      }
    }
    
    // Abrir modales
    if (openPrivacyBtn) {
      openPrivacyBtn.addEventListener('click', () => openModal(privacyModal));
    }
    if (openTermsBtn) {
      openTermsBtn.addEventListener('click', () => openModal(termsModal));
    }
    
    // Cerrar con botón X
    closeButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        closeModal(privacyModal);
        closeModal(termsModal);
      });
    });
    
    // Cerrar al hacer clic fuera del modal
    window.addEventListener('click', (e) => {
      if (privacyModal && e.target === privacyModal) {
        closeModal(privacyModal);
      }
      if (termsModal && e.target === termsModal) {
        closeModal(termsModal);
      }
    });
    
    // Cerrar con tecla ESC
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeModal(privacyModal);
        closeModal(termsModal);
      }
    });
  })();
</script>

<style is:global>
  .social-icon {
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  .social-icon:hover {
    transform: translateY(-3px) scale(1.1);
  }
  
  .modal {
    animation: fadeIn 0.3s ease-out;
  }
  
  .modal-container {
    animation: slideIn 0.3s ease-out;
  }
  
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  
  @keyframes slideIn {
    from {
      opacity: 0;
      transform: translateY(-30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>