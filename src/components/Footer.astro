---
const currentPath = Astro.url.pathname;
const isSpanish = currentPath.startsWith('/es') || currentPath === '/';
const currentLang = isSpanish ? 'es' : 'en';

const texts = {
  es: {
    brandDesc: 'Agencia de marketing, producción audiovisual y gestión de redes sociales.',
    services: 'Servicios',
    servicesList: ['Diseño Gráfico', 'Material Publicitario', 'Gestión de RRSS', 'Edición de Videos'],
    contact: 'Contacto',
    contactInfo: { email: 'Cygnusmedia2@gmail.com', phone: '+58 414-1586749', whatsapp: '+58 414-1586749' },
    links: 'Enlaces rápidos',
    rights: 'Todos los derechos reservados',
    social: 'Síguenos',
    legal: { privacy: 'Privacidad', terms: 'Términos' }
  },
  en: {
    brandDesc: 'Marketing agency, audiovisual production and social media management.',
    services: 'Services',
    servicesList: ['Graphic Design', 'Advertising Material', 'Social Media Management', 'Video Editing'],
    contact: 'Contact',
    contactInfo: { email: 'Cygnusmedia2@gmail.com', phone: '+58 414-1586749', whatsapp: '+58 414-1586749' },
    links: 'Quick links',
    rights: 'All rights reserved',
    social: 'Follow us',
    legal: { privacy: 'Privacy', terms: 'Terms' }
  }
};

const t = texts[currentLang];
const currentYear = new Date().getFullYear();
---
<footer class="bg-gray-950 text-white border-t border-gray-900">
  <div class="container mx-auto px-6 py-20 max-w-7xl">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12">
      
      <!-- Brand -->
<div class="space-y-6">
  <div class="flex items-center gap-3">
    <div class="w-12 h-12 flex items-center justify-center">
      <img 
        src="/assets/logoprincipal.png" 
        alt="Cygnus Visual Logo" 
        class="w-full h-full object-contain" 
      />
    </div>
    <h3 class="text-xl font-black tracking-tighter">CYGNUS<span class="text-blue-600">VISUAL</span></h3>
  </div>
  <p class="text-gray-500 text-sm leading-relaxed">{t.brandDesc}</p>
</div>
      
      <!-- Servicios -->
      <div>
        <h4 class="text-xs font-black text-gray-400 uppercase tracking-widest mb-6">{t.services}</h4>
        <ul class="space-y-4">
          {t.servicesList.map((service) => (
            <li><a href="#services" class="text-gray-300 hover:text-blue-500 transition-all font-bold text-sm">{service}</a></li>
          ))}
        </ul>
      </div>
      
      <!-- Contacto -->
      <div>
        <h4 class="text-xs font-black text-gray-400 uppercase tracking-widest mb-6">{t.contact}</h4>
        <div class="space-y-4 text-sm font-bold text-gray-300">
          <p>{t.contactInfo.email}</p>
          <p>{t.contactInfo.phone}</p>
        </div>
      </div>
      
      <!-- Redes Sociales (Actualizado) -->
<div>
  <h4 class="text-xs font-black text-gray-400 uppercase tracking-widest mb-6">{t.social}</h4>
  
  <a 
    href="https://www.instagram.com/cygnustudios.ve" 
    target="_blank" 
    class="flex items-center gap-4 group transition-transform hover:scale-105 duration-300 w-fit"
  >
    <div class="w-16 h-16 flex items-center justify-center">
      <img 
        src="/assets/logoprincipal.png" 
        alt="Cygnus Visual Logo" 
        class="w-full h-full object-contain" 
      />
    </div>
    
    <div class="flex flex-col">
      <span class="text-xs font-black text-white uppercase tracking-wider">Cygnus Studios</span>
      <span class="text-[11px] font-bold text-blue-500">@cygnustudios.ve</span>
    </div>
  </a>
</div>
    </div>
  </div>

  <!-- Bottom -->
  <div class="border-t border-gray-900 py-8">
    <div class="container mx-auto px-6 max-w-7xl flex flex-col md:flex-row justify-between items-center gap-6 text-[11px] font-black uppercase tracking-widest text-gray-500">
      
      <p>
        © {currentYear} Cygnus Visual. {t.rights}. 
        <span class="text-gray-700">|</span> 
        Desarrollado por 
        <a href="https://www.instagram.com/jferr3r/" target="_blank" class="text-blue-500 hover:text-white transition-colors">@jferr3r</a>
      </p>

      <div class="flex gap-8">
        <button id="open-privacy" class="hover:text-blue-500 transition-colors">Privacidad</button>
        <button id="open-terms" class="hover:text-blue-500 transition-colors">Términos</button>
      </div>
    </div>
  </div>
</footer>