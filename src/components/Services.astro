---
// 1. Recibimos la prop original de traducciones
const { t } = Astro.props;

// 2. Extraemos el bloque de servicios de forma segura
const services = t?.services || {};

// 3. Obtener los items directamente desde la estructura del JSON
// Tu JSON tiene: services.design.items (array)
const designItems = services.design?.items || [];
const advertisingItems = services.advertising?.items || [];

// 4. Servicios adicionales
const additionalItems = services.additional?.items || [];
---

<section id="services" class="py-24 bg-gradient-to-b from-white to-gray-50">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-20">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-azul-rey/5 rounded-full border border-azul-rey/10 mb-6">
        <svg class="w-4 h-4 text-azul-rey" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 2a3.53 3.53 0 0 0-2.5 1.06A3.54 3.54 0 0 0 8.5 5.6a5.47 5.47 0 0 0-1.6 0A3.53 3.53 0 0 0 4.5 7.4 3.54 3.54 0 0 0 6.5 12a3.53 3.53 0 0 0-2 4.6 3.54 3.54 0 0 0 4.6 2 5.47 5.47 0 0 0 0 1.6 3.53 3.53 0 0 0 1.9 2.9 3.54 3.54 0 0 0 4.6-2 5.47 5.47 0 0 0 1.6 0 3.53 3.53 0 0 0 2.9-1.9 3.54 3.54 0 0 0-2-4.6 5.47 5.47 0 0 0 0-1.6 3.53 3.53 0 0 0-1.9-2.9 3.54 3.54 0 0 0-4.6 2 5.47 5.47 0 0 0-1.6 0A3.53 3.53 0 0 0 12 2Z"/>
        </svg>
        <span class="text-xs font-semibold text-azul-rey uppercase tracking-wider">Expertos en comunicación visual</span>
      </div>
      
      <h2 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-gray-900 mb-4 tracking-tight">
        {services.title || "Nuestros"}<span class="text-azul-rey"> Servicios</span>
      </h2>
      
      <div class="flex justify-center gap-1 mb-6">
        <svg class="w-5 h-5 text-azul-rey fill-azul-rey" viewBox="0 0 24 24" fill="currentColor" stroke="none">
          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
        </svg>
        <svg class="w-5 h-5 text-azul-rey fill-azul-rey" viewBox="0 0 24 24" fill="currentColor" stroke="none">
          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
        </svg>
        <svg class="w-5 h-5 text-azul-rey fill-azul-rey" viewBox="0 0 24 24" fill="currentColor" stroke="none">
          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
        </svg>
        <svg class="w-5 h-5 text-azul-rey fill-azul-rey" viewBox="0 0 24 24" fill="currentColor" stroke="none">
          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
        </svg>
        <svg class="w-5 h-5 text-azul-rey fill-azul-rey" viewBox="0 0 24 24" fill="currentColor" stroke="none">
          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
        </svg>
      </div>
      
      <p class="text-gray-500 text-lg">
        {services.subtitle || "Soluciones creativas y profesionales para potenciar tu marca"}
      </p>
    </div>
    
    <div class="grid lg:grid-cols-2 gap-8 max-w-6xl mx-auto mb-24">
      
      <!-- Diseño Gráfico -->
      <div class="group relative">
        <div class="relative bg-white rounded-2xl shadow-lg border border-gray-100 p-8 hover:shadow-2xl transition-all duration-500 hover:-translate-y-1">
          
          <div class="mb-6">
            <div class="w-16 h-16 bg-gradient-to-br from-azul-rey to-azul-rey/80 rounded-2xl flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform duration-300">
              <svg class="w-8 h-8 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
            </div>
          </div>
          
          <h3 class="text-2xl font-bold text-gray-900 mb-2">{services.design?.title || "Diseño Gráfico"}</h3>
          <div class="w-12 h-0.5 bg-azul-rey mb-4"></div>
          <p class="text-gray-500 mb-6">
            {services.design?.description || "Creamos identidades visuales únicas que reflejan la esencia de tu marca."}
          </p>
          
          <div class="grid grid-cols-2 gap-3 mb-6">
            {designItems.map((item: string, idx: number) => (
              <div class="flex items-center gap-2 py-1.5 group/item">
                <div class="w-1.5 h-1.5 bg-azul-rey rounded-full group-hover/item:scale-125 transition-transform"></div>
                <span class="text-sm text-gray-600 group-hover/item:text-gray-900">
                  {item}
                </span>
              </div>
            ))}
          </div>
          
          <div class="pt-4 border-t border-gray-100">
            <span class="inline-flex items-center gap-1 text-xs text-gray-400">
              <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 2a3.53 3.53 0 0 0-2.5 1.06A3.54 3.54 0 0 0 8.5 5.6a5.47 5.47 0 0 0-1.6 0A3.53 3.53 0 0 0 4.5 7.4 3.54 3.54 0 0 0 6.5 12a3.53 3.53 0 0 0-2 4.6 3.54 3.54 0 0 0 4.6 2 5.47 5.47 0 0 0 0 1.6 3.53 3.53 0 0 0 1.9 2.9 3.54 3.54 0 0 0 4.6-2 5.47 5.47 0 0 0 1.6 0 3.53 3.53 0 0 0 2.9-1.9 3.54 3.54 0 0 0-2-4.6 5.47 5.47 0 0 0 0-1.6 3.53 3.53 0 0 0-1.9-2.9 3.54 3.54 0 0 0-4.6 2 5.47 5.47 0 0 0-1.6 0A3.53 3.53 0 0 0 12 2Z"/>
              </svg>
              Incluye asesoría personalizada
            </span>
          </div>
        </div>
      </div>
      
      <!-- Material Publicitario -->
      <div class="group relative">
        <div class="relative bg-white rounded-2xl shadow-lg border border-gray-100 p-8 hover:shadow-2xl transition-all duration-500 hover:-translate-y-1">
          
          <div class="mb-6">
            <div class="w-16 h-16 bg-gradient-to-br from-azul-rey to-azul-rey/80 rounded-2xl flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform duration-300">
              <svg class="w-8 h-8 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
              </svg>
            </div>
          </div>
          
          <h3 class="text-2xl font-bold text-gray-900 mb-2">{services.advertising?.title || "Material Publicitario"}</h3>
          <div class="w-12 h-0.5 bg-azul-rey mb-4"></div>
          <p class="text-gray-500 mb-6">
            {services.advertising?.description || "Diseños impactantes que capturan atención y comunican tu mensaje."}
          </p>
          
          <div class="grid grid-cols-2 gap-3 mb-6">
            {advertisingItems.map((item: string, idx: number) => (
              <div class="flex items-center gap-2 py-1.5 group/item">
                <div class="w-1.5 h-1.5 bg-azul-rey rounded-full group-hover/item:scale-125 transition-transform"></div>
                <span class="text-sm text-gray-600 group-hover/item:text-gray-900">
                  {item}
                </span>
              </div>
            ))}
          </div>
          
          <div class="pt-4 border-t border-gray-100">
            <span class="inline-flex items-center gap-1 text-xs text-gray-400">
              <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 2a3.53 3.53 0 0 0-2.5 1.06A3.54 3.54 0 0 0 8.5 5.6a5.47 5.47 0 0 0-1.6 0A3.53 3.53 0 0 0 4.5 7.4 3.54 3.54 0 0 0 6.5 12a3.53 3.53 0 0 0-2 4.6 3.54 3.54 0 0 0 4.6 2 5.47 5.47 0 0 0 0 1.6 3.53 3.53 0 0 0 1.9 2.9 3.54 3.54 0 0 0 4.6-2 5.47 5.47 0 0 0 1.6 0 3.53 3.53 0 0 0 2.9-1.9 3.54 3.54 0 0 0-2-4.6 5.47 5.47 0 0 0 0-1.6 3.53 3.53 0 0 0-1.9-2.9 3.54 3.54 0 0 0-4.6 2 5.47 5.47 0 0 0-1.6 0A3.53 3.53 0 0 0 12 2Z"/>
              </svg>
              Listos para impresión y digital
            </span>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Servicios adicionales -->
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-12">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-gray-100 rounded-full">
          <svg class="w-4 h-4 text-azul-rey" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 2a3.53 3.53 0 0 0-2.5 1.06A3.54 3.54 0 0 0 8.5 5.6a5.47 5.47 0 0 0-1.6 0A3.53 3.53 0 0 0 4.5 7.4 3.54 3.54 0 0 0 6.5 12a3.53 3.53 0 0 0-2 4.6 3.54 3.54 0 0 0 4.6 2 5.47 5.47 0 0 0 0 1.6 3.53 3.53 0 0 0 1.9 2.9 3.54 3.54 0 0 0 4.6-2 5.47 5.47 0 0 0 1.6 0 3.53 3.53 0 0 0 2.9-1.9 3.54 3.54 0 0 0-2-4.6 5.47 5.47 0 0 0 0-1.6 3.53 3.53 0 0 0-1.9-2.9 3.54 3.54 0 0 0-4.6 2 5.47 5.47 0 0 0-1.6 0A3.53 3.53 0 0 0 12 2Z"/>
          </svg>
          <span class="text-sm text-gray-600 font-medium">Servicios complementarios</span>
        </div>
        <h3 class="text-2xl font-bold text-gray-800 mt-4">{services.additional?.title || "También ofrecemos"}</h3>
        <div class="w-16 h-0.5 bg-azul-rey mx-auto mt-3"></div>
      </div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        {additionalItems.map((item: any) => {
          // Determinar icono basado en el título
          let iconSvg;
          const title = item.title || "";
          if (title.includes("Gestión") || title.includes("Management")) {
            iconSvg = (
              <svg class="w-7 h-7 text-azul-rey group-hover:text-white transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 0 0-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
              </svg>
            );
          } else if (title.includes("Video") || title.includes("Edición")) {
            iconSvg = (
              <svg class="w-7 h-7 text-azul-rey group-hover:text-white transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
              </svg>
            );
          } else if (title.includes("Planificación") || title.includes("Planning")) {
            iconSvg = (
              <svg class="w-7 h-7 text-azul-rey group-hover:text-white transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
            );
          } else {
            iconSvg = (
              <svg class="w-7 h-7 text-azul-rey group-hover:text-white transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/>
                <path d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            );
          }
          
          return (
            <div class="group bg-white rounded-xl shadow-md border border-gray-100 p-6 text-center hover:shadow-xl transition-all duration-300 hover:-translate-y-1 cursor-pointer">
              <div class="w-14 h-14 bg-azul-rey/10 rounded-xl flex items-center justify-center mx-auto mb-4 group-hover:bg-azul-rey transition-all duration-300">
                {iconSvg}
              </div>
              <h4 class="font-bold text-gray-800 mb-2">{item.title}</h4>
              <p class="text-gray-500 text-sm">{item.description}</p>
            </div>
          );
        })}
      </div>
    </div>
    
    <div class="text-center mt-20">
      <a 
        href="#contact" 
        class="group inline-flex items-center gap-2 px-8 py-4 bg-gray-900 text-white rounded-xl font-semibold hover:bg-azul-rey transition-all duration-300 shadow-lg hover:shadow-xl"
      >
        <span>{services.cta || "Solicita información"}</span>
        <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>
    
  </div>
</section>