---
const { t } = Astro.props;
const services = t?.services || {};

const mainServices = [
  { title: "MARKETING", desc: "Escala tu negocio.", icon: "🚀" },
  { title: "GESTIÓN DE REDES", desc: "Estrategia y contenido.", icon: "📱" },
  { title: "EDICIÓN DE VIDEOS", desc: "Post-producción pro.", icon: "🎬" }
];

const secondaryItems = [
  ...services.design?.items || [],
  ...services.advertising?.items || []
];
---

<section id="services" class="py-20 bg-white text-gray-900 overflow-hidden">
  <div class="container mx-auto px-4">
    
    <div class="text-center max-w-xl mx-auto mb-16">
      <h2 class="text-4xl font-black mb-3 tracking-tight">{services.title}</h2>
      <div class="h-1 w-20 bg-gradient-to-r from-blue-600 to-azul-rey mx-auto rounded-full"></div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-10">
      {mainServices.map((service) => (
        <div class="group relative bg-white p-8 rounded-[2rem] border border-gray-200 transition-all duration-500 hover:border-transparent hover:shadow-[0_0_40px_-10px_rgba(37,99,235,0.5)] overflow-hidden">
          <div class="absolute inset-0 border-2 border-transparent group-hover:border-blue-600 rounded-[2rem] transition-all duration-500"></div>
          
          <div class="relative z-10 flex flex-col items-center text-center">
            <div class="text-4xl mb-4 bg-gradient-to-br from-blue-100 to-blue-50 p-4 rounded-full">{service.icon}</div>
            <h3 class="text-lg font-black mb-2">{service.title}</h3>
            <p class="text-xs text-gray-500 leading-relaxed">{service.desc}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="bg-gradient-to-b from-gray-50 to-white border border-gray-100 rounded-[2rem] p-8 shadow-inner">
      <h4 class="text-center text-[10px] font-black text-blue-600 uppercase tracking-[0.3em] mb-8">Soluciones Especializadas</h4>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        {secondaryItems.map((item: string) => (
          <div class="flex items-center justify-center text-[11px] font-bold text-gray-700 bg-white border border-gray-200 py-4 px-3 rounded-2xl text-center shadow-sm hover:bg-blue-600 hover:text-white transition-all duration-300">
            {item}
          </div>
        ))}
      </div>
    </div>

    <div class="text-center mt-12">
      <a href="#contact" class="inline-flex items-center px-10 py-4 bg-gray-900 text-white font-bold text-sm rounded-full shadow-[0_10px_30px_-10px_rgba(0,0,0,0.3)] hover:shadow-[0_0_30px_rgba(37,99,235,0.5)] transition-all">
        {services.cta}
      </a>
    </div>
  </div>
</section>