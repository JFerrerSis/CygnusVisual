---
const { t } = Astro.props;
const servicesData = t?.services || {};

// Unificamos el array, poniendo primero los servicios adicionales
const additionalItems = (servicesData.additional?.items || []).map((item: any) => ({
    ...item,
    icon: "", 
    isMain: false
}));

const mainServices = [
  { ...servicesData.design, icon: "", isMain: true },
  { ...servicesData.advertising, icon: "", isMain: true }
];

// Aquí cambiamos el orden: primero los adicionales, luego los principales
const allServices = [...additionalItems, ...mainServices];
---

<section id="services" class="relative py-24 bg-white text-gray-900 overflow-hidden">
  <div class="absolute inset-0 z-0 bg-[radial-gradient(circle_at_top_right,_var(--tw-gradient-stops))] from-blue-100/50 via-white to-white"></div>

  <div class="container mx-auto px-6 max-w-7xl relative z-10">
    <div class="mb-16">
      <h2 class="text-4xl md:text-5xl font-black mb-4 tracking-tighter">
        {servicesData.title}<span class="text-azul-rey">.</span>
      </h2>
      <p class="text-gray-500 max-w-lg">{servicesData.subtitle}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      
      {allServices.map((s) => (
        <div class="service-card bg-white border-2 border-azul-rey/30 rounded-[2.5rem] p-8 flex flex-col h-full shadow-[0_0_40px_rgba(0,51,160,0.1)] hover:shadow-[0_0_60px_rgba(0,51,160,0.2)] transition-shadow">
          <span class="text-4xl mb-6">{s.icon}</span>
          <h3 class="text-2xl font-black mb-3">{s.title}</h3>
          <p class="text-gray-600 text-sm mb-8 flex-grow">{s.description}</p>
          
          {s.isMain ? (
            <div class="grid grid-cols-2 gap-2 mt-auto pt-6 border-t border-blue-50">
              {s.items.map((item: string) => (
                <span class="text-[10px] bg-azul-rey text-white font-bold px-3 py-2 rounded-lg text-center shadow-lg shadow-azul-rey/30">
                  {item}
                </span>
              ))}
            </div>
          ) : (
             <a href="#contact" class="mt-auto pt-6 text-azul-rey font-black text-sm flex items-center gap-2 hover:translate-x-2 transition-transform">
               {servicesData.cta} →
             </a>
          )}
        </div>
      ))}
      
    </div>
  </div>
</section>

<style>
  .service-card {
    animation: fadeInUp 0.8s ease-out forwards;
    opacity: 0;
  }
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

<script>
  document.getElementById('services-cta')?.addEventListener('click', (e) => {
    e.preventDefault();
    document.getElementById('contact')?.scrollIntoView({ behavior: 'smooth' });
  });
</script>