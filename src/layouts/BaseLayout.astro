---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import '../styles/globals.css';

// Recibir el idioma como prop
const { lang = 'es', title = 'Cygnus Visual' } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content="Agencia de marketing, producción audiovisual y gestión de redes sociales" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-white text-gray-900">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <WhatsAppButton />
    
    <!-- Scripts globales -->
    <script type="module" src="/src/scripts/animations.js"></script>
  </body>
</html>