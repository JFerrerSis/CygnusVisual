---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import Preloader from '../components/Preloader.astro';
import '../styles/globals.css';

// Recibir el idioma y las traducciones como props
const { lang = 'es', title = 'Cygnus Visual', t } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#000a1f" /> 
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <title>{title}</title>
    <meta name="description" content="Agencia de marketing, producción audiovisual y gestión de redes sociales" />
    <link rel="icon" type="image/svg+xml" href="/assets/azul.webp" />
  </head>
  <body class=" ">
    <Header t={t} />
    <main>
    <Preloader />  <slot />
    </main>
    <Footer />
    
    <!-- Scripts globales -->
  </body>
</html>